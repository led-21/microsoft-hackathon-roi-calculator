# ==============================================================================
# InovaROI - Environment Configuration Template
# ==============================================================================
# NOTE: The system runs 100% locally with zero cloud dependencies by default:
# - Storage: SQLite fallback (roidb.db) when SQL Server / Azure SQL is omitted.
# - Caching: In-memory distributed cache when Redis is omitted.
# - Reports: Deterministic local executive report engine when Azure OpenAI is omitted.
# ==============================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Connections (Optional - falls back to local SQLite "roidb.db")
# ConnectionStrings__roidb=Server=localhost,1433;Database=roidb;User Id=sa;Password=YourStrong@Password;TrustServerCertificate=True;

# Distributed Cache (Optional - falls back to in-memory distributed cache)
# ConnectionStrings__cache=localhost:6379

# Azure OpenAI / GenAI Service (Optional - falls back to local deterministic executive report engine)
AzureOpenAI__Endpoint=https://<your-resource-name>.openai.azure.com/
AzureOpenAI__ApiKey=<your-azure-openai-api-key>
AzureOpenAI__DeploymentName=gpt-4o

# Aspire / Frontend API Configuration
ApiBaseUrl=https://localhost:7288
