@page "/calculator"
@using System.Globalization
@using microsoft_hackathon_roi_calculator.Domain.Models
@using microsoft_hackathon_roi_calculator.Web.Services

@inject IToastService ToastService
@inject RoiApiClient ApiClient
@inject AppStateService AppState
@inject MarkdownService Markdown
@inject NavigationManager Navigation

<FluentLabel Typo="Typography.H3">Calculadora de ROI</FluentLabel>

@if (isCalculating)
{
    <FluentCard Style="margin-top: 1rem; padding: 2rem;">
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
            <FluentProgressRing Size="ProgressRingSize.Medium" />
            <FluentLabel Typo="Typography.H4">Processando simulação financeira e projeção de riscos...</FluentLabel>
            <FluentLabel Typo="Typography.Body">Avaliando curva de adoção, taxa de desengajamento e retorno esperado.</FluentLabel>
        </FluentStack>
    </FluentCard>
}
else
{
    <FluentGrid>
        <FluentGridItem xs="12" md="6">
            <FluentCard xs="12" Height="auto" Style="padding: 20px; margin: 10px;">
                <FluentLabel Typo="Typography.H5" Style="margin-bottom: 8px;">Parâmetros da Iniciativa</FluentLabel>

                <div style="margin-bottom: 14px;">
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; font-size: 0.85rem; color: var(--neutral-foreground-hint);">Cenários Pré-configurados (1-Clique):</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" Style="gap: 6px; margin-top: 4px;">
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Neutral" OnClick="@(() => ApplyPreset("cloud"))">☁️ Nuvem</FluentButton>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Neutral" OnClick="@(() => ApplyPreset("copilot"))">🤖 Copilot / IA</FluentButton>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Neutral" OnClick="@(() => ApplyPreset("erp"))">🔄 ERP</FluentButton>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Neutral" OnClick="@(() => ApplyPreset("devops"))">⚡ DevSecOps</FluentButton>
                    </FluentStack>
                </div>

                <FluentTextField Label="Orçamento do Projeto (R$)"
                                 @bind-Value="formattedBudget" />

                <FluentNumberField Label="Número de Funcionários Impactados"
                                   Type="number"
                                   @bind-Value="AppState.CurrentInput.NumberOfEmployees" />

                <FluentNumberField Label="Duração do Projeto (meses)"
                                   Type="number"
                                   @bind-Value="AppState.CurrentInput.ProjectDurationMonths" />

                <FluentStack Orientation="Orientation.Vertical" Style="margin-top: 8px;">
                    <FluentNumberField Label="Probabilidade de Falha Projetada (%)"
                                       Type="number"
                                       Step="0.01"
                                       @bind-Value="@AppState.CurrentInput.FailureRate" />

                    <FluentButton Appearance="Appearance.Outline"
                                  Size="ButtonSize.Small"
                                  Loading="isEstimatingML"
                                  OnClick="DetermineProbability">
                        Estimar Risco via Machine Learning (ML.NET)
                    </FluentButton>

                    @if (!string.IsNullOrEmpty(failProbabilityNotice))
                    {
                        <FluentMessageBar Intent="@(usedMlOffline ? MessageIntent.Warning : MessageIntent.Info)" Style="margin-top: 6px;">
                            @failProbabilityNotice
                        </FluentMessageBar>
                    }
                </FluentStack>

                <FluentAccordion Style="margin-top: 15px;">
                    <FluentAccordionItem Heading="Parâmetros Avançados e Premissas Financeiras">
                        <FluentIcon Value="@(new Icons.Regular.Size24.AddSquareMultiple())" Color="@Color.Neutral" Slot="start" />
                        
                        <FluentNumberField Label="Taxa de Perda do Orçamento em Caso de Falha (%)"
                                           Type="number"
                                           Step="0.01"
                                           @bind-Value="AppState.CurrentInput.BudgetLossRate" />

                        <FluentNumberField Label="Taxa de Perda por Desengajamento (%)"
                                           Type="number"
                                           Step="0.01"
                                           @bind-Value="AppState.CurrentInput.ExpectedDisengagementRate" />

                        <FluentNumberField Label="Fator de Ganho de Produtividade (ex: 1.20 = +20%)"
                                           Type="number"
                                           Step="0.05"
                                           @bind-Value="AppState.CurrentInput.ExpectedProductivityGain" />

                        <FluentNumberField Label="Redução Projetada de Risco de Falha (%)"
                                           Type="number"
                                           Step="0.01"
                                           @bind-Value="AppState.CurrentInput.ProjectedRiskReduction" />

                        <FluentNumberField Label="Fator de Benefício de Sucesso (%)"
                                           Type="number"
                                           Step="0.01"
                                           @bind-Value="AppState.CurrentInput.ExpectedSuccessBenefit" />
                    </FluentAccordionItem>
                </FluentAccordion>

                <FluentStack Orientation="Orientation.Horizontal" Style="margin-top: 20px;">
                    <FluentButton OnClick="SubmitForm" Appearance="Appearance.Accent">
                        Calcular ROI e Projeções
                    </FluentButton>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>

        <!-- Relatório de ROI do Projeto -->
        <FluentGridItem xs="12" md="6">
            @if (AppState.HasCalculated)
            {
                <FluentCard Style="padding: 20px; margin: 10px; max-height: 780px; overflow-y: auto;">
                    @if (usedOfflineCalculation)
                    {
                        <FluentBadge Appearance="Appearance.Neutral" Style="margin-bottom: 10px;">
                            Modo Local / Offline Ativo
                        </FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Accent" Style="margin-bottom: 10px;">
                            Calculado via InovaROI Service API
                        </FluentBadge>
                    }

                    <div class="markdown-report">
                        @((MarkupString)AppState.CalculationResultHtml)
                    </div>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top: 16px; border-top: 1px solid var(--neutral-stroke-rest, #e0e0e0); padding-top: 12px;">
                        <FluentButton Appearance="Appearance.Accent" IconEnd="@(new Icons.Regular.Size16.ArrowRight())" OnClick="@(() => Navigation.NavigateTo("/report"))">
                            Ver Relatório Executivo Completo
                        </FluentButton>
                    </FluentStack>
                </FluentCard>
            }
            else
            {
                <FluentCard Style="padding: 25px; margin: 10px; text-align: center;">
                    <FluentIcon Value="@(new Icons.Regular.Size24.BrainCircuit())" Color="@Color.Accent" />
                    <FluentLabel Typo="Typography.H5" Style="margin-top: 10px;">Aguardando Parâmetros</FluentLabel>
                    <FluentLabel Typo="Typography.Body">
                        Preencha o orçamento, colaboradores e duração ao lado e clique em <strong>"Calcular ROI e Projeções"</strong> para gerar o balanço financeiro, relação benefício/custo e recomendações de governança.
                    </FluentLabel>
                </FluentCard>
            }
        </FluentGridItem>
    </FluentGrid>
}

@code {
    private bool isCalculating = false;
    private bool isEstimatingML = false;
    private bool usedOfflineCalculation = false;
    private bool usedMlOffline = false;
    private string failProbabilityNotice = string.Empty;

    private async Task SubmitForm()
    {
        isCalculating = true;
        try
        {
            var (markdown, offline) = await ApiClient.CalculateRoiAsync(AppState.CurrentInput);
            usedOfflineCalculation = offline;

            var html = Markdown.ConvertToHtml(markdown);
            AppState.SetCalculationResult(markdown, html);

            if (offline)
            {
                ToastService.ShowInfo("Simulação concluída com sucesso via motor financeiro nativo .NET!");
            }
            else
            {
                ToastService.ShowSuccess("Simulação calculada com sucesso pela API InovaROI.");
            }

            // Generate detailed narrative report
            var (aiReport, _) = await ApiClient.GenerateAiReportAsync(markdown);
            AppState.SetDetailReport(aiReport);
        }
        catch (Exception ex)
        {
            ToastService.ShowWarning($"Falha na simulação: {ex.Message}");
        }
        finally
        {
            isCalculating = false;
        }
    }

    private async Task DetermineProbability()
    {
        isEstimatingML = true;
        try
        {
            var (estimatedRate, offline) = await ApiClient.EstimateFailureRateAsync(AppState.CurrentInput);
            AppState.CurrentInput.FailureRate = estimatedRate;
            usedMlOffline = offline;

            var percentage = (estimatedRate * 100).ToString("F1", CultureInfo.InvariantCulture);
            failProbabilityNotice = offline 
                ? $"Probabilidade estimada pelo modelo heurístico offline: {percentage}%"
                : $"Probabilidade de falha estimada pelo modelo ML.NET: {percentage}%";

            ToastService.ShowInfo($"Taxa de falha atualizada para {percentage}%.");
        }
        catch
        {
            failProbabilityNotice = "Não foi possível estimar a probabilidade no momento.";
        }
        finally
        {
            isEstimatingML = false;
        }
    }

    private string formattedBudget
    {
        get => AppState.CurrentInput.ProjectBudget.ToString("C", new CultureInfo("pt-BR"));
        set
        {
            if (double.TryParse(value, NumberStyles.Currency, new CultureInfo("pt-BR"), out var result))
            {
                AppState.CurrentInput.ProjectBudget = result;
            }
            else if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var invResult))
            {
                AppState.CurrentInput.ProjectBudget = invResult;
            }
        }
    }

    private void ApplyPreset(string preset)
    {
        switch (preset)
        {
            case "cloud":
                AppState.CurrentInput.ProjectBudget = 1500000;
                AppState.CurrentInput.NumberOfEmployees = 350;
                AppState.CurrentInput.ProjectDurationMonths = 12;
                AppState.CurrentInput.FailureRate = 0.45;
                AppState.CurrentInput.BudgetLossRate = 0.30;
                AppState.CurrentInput.ExpectedDisengagementRate = 0.12;
                AppState.CurrentInput.ExpectedProductivityGain = 1.25;
                AppState.CurrentInput.ProjectedRiskReduction = 0.40;
                AppState.CurrentInput.ExpectedSuccessBenefit = 0.35;
                ToastService.ShowInfo("Cenário de Migração Cloud aplicado!");
                break;
            case "copilot":
                AppState.CurrentInput.ProjectBudget = 600000;
                AppState.CurrentInput.NumberOfEmployees = 180;
                AppState.CurrentInput.ProjectDurationMonths = 6;
                AppState.CurrentInput.FailureRate = 0.35;
                AppState.CurrentInput.BudgetLossRate = 0.20;
                AppState.CurrentInput.ExpectedDisengagementRate = 0.10;
                AppState.CurrentInput.ExpectedProductivityGain = 1.30;
                AppState.CurrentInput.ProjectedRiskReduction = 0.50;
                AppState.CurrentInput.ExpectedSuccessBenefit = 0.40;
                ToastService.ShowInfo("Cenário de Adoção de IA / Copilot aplicado!");
                break;
            case "erp":
                AppState.CurrentInput.ProjectBudget = 2800000;
                AppState.CurrentInput.NumberOfEmployees = 750;
                AppState.CurrentInput.ProjectDurationMonths = 18;
                AppState.CurrentInput.FailureRate = 0.60;
                AppState.CurrentInput.BudgetLossRate = 0.40;
                AppState.CurrentInput.ExpectedDisengagementRate = 0.20;
                AppState.CurrentInput.ExpectedProductivityGain = 1.18;
                AppState.CurrentInput.ProjectedRiskReduction = 0.30;
                AppState.CurrentInput.ExpectedSuccessBenefit = 0.25;
                ToastService.ShowInfo("Cenário de Modernização ERP aplicado!");
                break;
            case "devops":
                AppState.CurrentInput.ProjectBudget = 450000;
                AppState.CurrentInput.NumberOfEmployees = 90;
                AppState.CurrentInput.ProjectDurationMonths = 8;
                AppState.CurrentInput.FailureRate = 0.30;
                AppState.CurrentInput.BudgetLossRate = 0.25;
                AppState.CurrentInput.ExpectedDisengagementRate = 0.08;
                AppState.CurrentInput.ExpectedProductivityGain = 1.35;
                AppState.CurrentInput.ProjectedRiskReduction = 0.45;
                AppState.CurrentInput.ExpectedSuccessBenefit = 0.35;
                ToastService.ShowInfo("Cenário de DevSecOps Ágil aplicado!");
                break;
        }
        StateHasChanged();
    }
}