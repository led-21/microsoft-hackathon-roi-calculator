@page "/dashboard"
@using System.Globalization
@using microsoft_hackathon_roi_calculator.Domain.Models
@using microsoft_hackathon_roi_calculator.Web.Pages.Charts
@using microsoft_hackathon_roi_calculator.Web.Services

@inject AppStateService AppState
@inject RoiApiClient ApiClient

<FluentLabel Typo="Typography.H3">Dashboard de Portfólio</FluentLabel>

<FluentGrid Spacing="1" Style="padding: 1rem 0;">
    <!-- Seção de Estatísticas -->
    @if (isLoading)
    {
        <FluentGridItem xs="12" sm="6" md="4" lg="3"
                        Style="display: flex; flex-direction: column; gap: 20px;">
            @for (int i = 0; i < 3; i++)
            {
                <FluentCard>
                    <FluentSkeleton Shape="SkeletonShape.Rect"
                                    Width="180px"
                                    Height="20px"
                                    Style="margin-bottom: 10px" />
                    <FluentSkeleton Shape="SkeletonShape.Rect"
                                    Width="120px"
                                    Height="30px" />
                </FluentCard>
            }
        </FluentGridItem>
    }
    else
    {
        <FluentGridItem xs="12" sm="6" md="4" lg="3"
                        Style="display: flex; flex-direction: column; gap: 20px;">
            <FluentCard>
                <FluentLabel Typo="Typography.Subject">Colaboradores Impactados</FluentLabel>
                <FluentLabel Typo="Typography.H4">@_numberOfEmployees</FluentLabel>
            </FluentCard>
            <FluentCard>
                <FluentLabel Typo="Typography.Subject">Retorno Total Estimado</FluentLabel>
                <FluentLabel Typo="Typography.H4">@_sumOfROI.ToString("C", ptBr)</FluentLabel>
                <FluentLabel Typo="Typography.Body">(@((_sumOfBudget > 0 ? (_sumOfROI / _sumOfBudget * 100) : 0).ToString("0.0"))%)</FluentLabel>
            </FluentCard>
            <FluentStack Orientation="Orientation.Horizontal">
                <FluentCard Style="flex: 1;">
                    <FluentLabel Typo="Typography.Subject">Projetos</FluentLabel>
                    <FluentLabel Typo="Typography.H5">@_numberOfProjects</FluentLabel>
                </FluentCard>
                <FluentCard Style="flex: 1;">
                    <FluentLabel Typo="Typography.Subject">Orçamento Total</FluentLabel>
                    <FluentLabel Typo="Typography.H5">@_sumOfBudget.ToString("C", ptBr)</FluentLabel>
                </FluentCard>
            </FluentStack>
        </FluentGridItem>
    }

    <!-- Gráfico -->
    @if (isLoading)
    {
        <FluentGridItem xs="12" md="8" lg="9">
            <FluentCard>
                <FluentSkeleton Shape="SkeletonShape.Rect"
                                Width="150px"
                                Height="20px" />
                <FluentSkeleton Shape="SkeletonShape.Rect"
                                Width="100%"
                                Height="200px" />
            </FluentCard>
        </FluentGridItem>
    }
    else
    {
        <FluentGridItem xs="12" md="8" lg="9">
            <FluentCard>
                <RadzenChart>
                    <RadzenAreaSeries Smooth="true" Data="@filteredProjetROIs" Title="ROI (%)" ValueProperty="ROI" CategoryProperty="ProjectName" RenderingOrder="1" Fill="rgba(16,112,227,.5)" Stroke="rgba(26,72,227,0.8)">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenAreaSeries>
                    <RadzenCategoryAxis Padding="20" LabelAutoRotation="-45">
                        <RadzenAxisTitle Text="Projeto" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@FormatAsPercentage">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="ROI (%)" />
                    </RadzenValueAxis>
                </RadzenChart>
            </FluentCard>
        </FluentGridItem>
    }

    <!-- Tabela -->
    <FluentGridItem xs="12">
        <FluentCard Style="margin-top: 1rem;">
            <FluentLabel Typo="Typography.H5" Style="margin-bottom: 12px;">Portfólio de Projetos Avaliados</FluentLabel>
            <FluentDataGrid @ref="dataGrid"
                            Items="@projects"
                            ItemSize="46"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            TGridItem="ProjectROI"
                            Loading="isLoading"
                            Pagination="pagination">
                <PropertyColumn Title="Id"
                                Property="@(c => c!.Id)"
                                Width="80px" />
                <PropertyColumn Title="Nome do Projeto"
                                Property="@(c => c!.ProjectName)"
                                Align="Align.Start" />
                <PropertyColumn Title="Orçamento"
                                Property="@(c => c!.ProjectBudget.ToString("C", ptBr))"
                                Align="Align.Center" />
                <PropertyColumn Title="Colaboradores"
                                Property="@(c => c!.NumberOfEmployees)"
                                Tooltip="true"
                                Align="Align.Center" />
                <PropertyColumn Title="ROI (%)"
                                Property="@(c => (c!.ROI * 100).ToString("0.0") + "%")" 
                                Align="Align.Center" />
            </FluentDataGrid>
            <FluentPaginator State="@pagination" />
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

@code {
    private bool isLoading = true;
    private CultureInfo ptBr = new CultureInfo("pt-BR");

    private IQueryable<ProjectROI> projects = default!;
    private IEnumerable<ProjectROI> filteredProjetROIs = default!;

    private int _numberOfProjects = 0;
    private int _numberOfEmployees = 0;
    private double _sumOfBudget = 0;
    private double _sumOfROI = 0;

    FluentDataGrid<ProjectROI> dataGrid = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;

        var list = await ApiClient.GetProjectsAsync();
        projects = list.AsQueryable();
        filteredProjetROIs = list.Take(pagination.ItemsPerPage).ToList();

        DashboardCalculations(list);
        await pagination.SetTotalItemCountAsync(list.Count);

        isLoading = false;
    }

    private void DashboardCalculations(List<ProjectROI> list)
    {
        _numberOfProjects = list.Count;
        _numberOfEmployees = list.Sum(p => p.NumberOfEmployees);
        _sumOfBudget = list.Sum(p => p.ProjectBudget);
        _sumOfROI = list.Sum(p => p.ProjectBudget * p.ROI);
    }

    private string FormatAsPercentage(object value)
    {
        if (value is double d)
            return (d * 100).ToString("N1") + "%";
        return value?.ToString() ?? "";
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}