@page "/projects"
@using microsoft_hackathon_roi_calculator.Domain.Models
@using microsoft_hackathon_roi_calculator.Web.Pages.Components
@using microsoft_hackathon_roi_calculator.Web.Services

@inject RoiApiClient ApiClient
@inject AppStateService AppState
@inject IToastService ToastService
@inject IDialogService DialogService

<FluentLabel Typo="Typography.H3">Projetos de Transformação</FluentLabel>

<FluentCard Height="auto" Style="margin: 1rem 0;">
    <!-- Acordeão para filtros -->
    <FluentAccordion>
        <FluentAccordionItem Heading="Filtros de Busca" Expanded="false">
            <FluentIcon Value="@(new Icons.Regular.Size20.FilterAdd())"
                        Color="@Color.Neutral"
                        Slot="start" />
            <FluentGrid Spacing="1"
                        Justify="Microsoft.FluentUI.AspNetCore.Components.JustifyContent.FlexStart"
                        Style="padding: 5px;">
                <FluentGridItem xs="12" sm="6" md="4">
                    <FluentTextField @bind-Value="_projectName"
                                     Label="Nome do Projeto" />
                </FluentGridItem>
            </FluentGrid>

            <!-- Botões do filtro -->
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal"
                         HorizontalAlignment="HorizontalAlignment.End">
                <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                              Disabled="loading"
                              OnClick="ClearFilters">
                    Limpar
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                              Appearance="Appearance.Accent"
                              Loading="loading"
                              OnClick="DataGridRefreshDataAsync">
                    Filtrar
                </FluentButton>
            </FluentStack>
        </FluentAccordionItem>
    </FluentAccordion>

    <!-- Tabela -->
    <FluentDataGrid @ref="dataGrid"
                    Items="@FilteredProjects"
                    ItemSize="46"
                    GenerateHeader="GenerateHeaderOption.Sticky"
                    TGridItem="ProjectROI"
                    Loading="loading"
                    Pagination="pagination">
        <!-- Colunas da tabela -->
        <PropertyColumn Title="Id"
                        Property="@(c => c!.Id)"
                        Width="80px" />
        <PropertyColumn Title="Nome do Projeto"
                        Property="@(c => c!.ProjectName)"
                        Align="Align.Start" />
        <PropertyColumn Title="Orçamento"
                        Property="@(c => c!.ProjectBudget.ToString("C", new System.Globalization.CultureInfo("pt-BR")))"
                        Align="Align.Center" />
        <PropertyColumn Title="Colaboradores"
                        Property="@(c => c!.NumberOfEmployees)"
                        Tooltip="true"
                        Align="Align.Center" />
        <PropertyColumn Title="ROI Estimado"
                        Property="@(c => (c!.ROI * 100).ToString("0.0") + "%")" 
                        Align="Align.Center" />

        <!-- Coluna de ações -->
        <TemplateColumn Title="Ações" Align="@Align.End">
            <FluentButton aria-label="Editar item"
                          IconEnd="@(new Icons.Regular.Size16.Edit())"
                          OnClick="@(() => UpdateProject(context))" />
            <FluentButton aria-label="Excluir item"
                          IconEnd="@(new Icons.Regular.Size16.Delete())"
                          OnClick="@(() => DeleteProject(context))" />
        </TemplateColumn>
    </FluentDataGrid>

    <!-- Paginação vinculada ao estado da tabela -->
    <FluentPaginator State="@pagination" />

    <!-- Botão de cadastro fora da tabela -->
    <FluentButton Appearance="Appearance.Accent"
                  @onclick="RegisterProject"
                  Style="margin-top: 10px;">
        Cadastrar Novo Projeto
    </FluentButton>
</FluentCard>

@code {
    FluentDataGrid<ProjectROI> dataGrid = default!;
    bool loading = true;
    string? _projectName = string.Empty;

    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    IDialogReference? _dialog;

    IQueryable<ProjectROI>? FilteredProjects =>
        string.IsNullOrWhiteSpace(_projectName)
            ? AppState.Projects.AsQueryable()
            : AppState.Projects.Where(x => x.ProjectName.Contains(_projectName, StringComparison.CurrentCultureIgnoreCase)).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await LoadProjects();
    }

    public async Task LoadProjects()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        var projects = await ApiClient.GetProjectsAsync();
        await pagination.SetTotalItemCountAsync(projects.Count);

        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearFilters()
    {
        _projectName = string.Empty;
    }

    private async Task DataGridRefreshDataAsync()
    {
        await dataGrid.RefreshDataAsync(true);
    }

    private async Task RegisterProject()
    {
        ProjectROI projectROI = new()
        {
            ProjectName = "Novo Projeto de Modernização",
            ProjectBudget = 500000,
            NumberOfEmployees = 150,
            ROI = 1.65,
            StartDate = DateTime.Now,
            TotalHoursWorkedWeekly = 40,
            CompletedTraining = 0,
            EmployeesUsingNewTool = 0,
            TotalChangeImplementationTime = 0,
            TotalPlannedImplementationTime = 0,
            TotalProcesses = 0,
            CompliantProcesses = 0,
            ProjectEvaluationTotalResponses = 0,
            ProjectEvaluationPositiveResponses = 0,
            ProjectEvaluationSumOfAllScores = 0
        };

        _dialog = await DialogService.ShowPanelAsync<Cadastrar>(projectROI, new DialogParameters<ProjectROI>()
        {
            Content = projectROI,
            Alignment = HorizontalAlignment.Right,
            Title = $"Cadastrar Projeto",
            PrimaryAction = "Salvar",
            SecondaryAction = "Cancelar",
            Width = "400px"
        });

        DialogResult result = await _dialog.Result;

        if (!result.Cancelled)
        {
            await ApiClient.SaveProjectAsync(projectROI);
            ToastService.ShowSuccess($"O Projeto '{projectROI.ProjectName}' foi adicionado com sucesso!");
            await LoadProjects();
        }
    }

    private async Task UpdateProject(ProjectROI projectROI)
    {
        var dialog = await DialogService.ShowPanelAsync<Cadastrar>(projectROI, new DialogParameters<ProjectROI>()
        {
            Content = projectROI,
            Alignment = HorizontalAlignment.Right,
            Title = $"Editar Projeto",
            PrimaryAction = "Salvar",
            SecondaryAction = "Cancelar",
            Width = "400px"
        });

        DialogResult result = await dialog.Result;

        if (!result.Cancelled)
        {
            await ApiClient.UpdateProjectAsync(projectROI);
            ToastService.ShowSuccess($"O Projeto '{projectROI.ProjectName}' foi atualizado com sucesso!");
            await LoadProjects();
        }
    }

    private async Task DeleteProject(ProjectROI project)
    {
        var dialogInstance = await DialogService.ShowDialogAsync(
            @<div>
                <FluentLabel>Tem certeza de que deseja excluir o projeto '<strong>@project.ProjectName</strong>'?</FluentLabel>
            </div>,
            new DialogParameters
            {
                Title = "Excluir Projeto",
                PrimaryAction = "Excluir",
                SecondaryAction = "Cancelar"
            });

        var result = await dialogInstance.Result;

        if (!result.Cancelled)
        {
            await ApiClient.DeleteProjectAsync(project.Id);
            ToastService.ShowInfo($"O Projeto '{project.ProjectName}' foi excluído.");
            await LoadProjects();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
