<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Página Não Encontrada</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <FluentCard Style="padding: 2rem; margin: 2rem; text-align: center;">
                <FluentLabel Typo="Typography.H4">Página Não Encontrada</FluentLabel>
                <p>O endereço solicitado não existe ou foi movido.</p>
                <FluentAnchor Href="/">Voltar para o Início</FluentAnchor>
            </FluentCard>
        </LayoutView>
    </NotFound>
</Router>